# Anthropic API Key (obrigatório)
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Configurações opcionais
DEBUG=false
CLAUDE_MODEL=claude-sonnet-4-20250514
MAX_TOKENS=4000
TEMPERATURE=0.3
DATABASE_URL=postgresql+psycopg://traduz_saude:traduz_saude@localhost:5432/traduz_saude
DATABASE_AUTO_MIGRATE=true
POSTGRES_ENABLE_PGVECTOR=true
STORAGE_BACKEND=filesystem
STORAGE_ROOT=./storage
STORAGE_KEEP_LEGACY_BASE64_HISTORY=false

# Cache
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=100

# Limites
MAX_TEXT_LENGTH=10000
FREE_TRANSLATIONS_LIMIT=3

# CORS (separar múltiplas origens com vírgula)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
